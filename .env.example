# API Base URL
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# PostgreSQL connection strings
# Use DATABASE_URL (pooled) for application queries
# Use DATABASE_URL_UNPOOLED (direct) for migrations and admin tasks

DATABASE_URL=postgresql://username:password@host/database
DATABASE_URL_UNPOOLED=postgresql://username:password@host/database

# Set false for local PostgreSQL; true for hosted PostgreSQL.
DATABASE_SSL=false

# JWT Authentication
JWT_SECRET=your-secret-key-change-this-in-production-minimum-32-characters-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
